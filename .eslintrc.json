{
  "env": {
    "browser": true
  },
  "extends": ["eslint:recommended", "standard"],
  "parserOptions": {
    "ecmaVersion": "latest",
    "sourceType": "module"
  },
  "globals": {
    "render": "readonly",
    "addWorkout": "readonly",
    "startEdit": "readonly",
    "saveEdit": "readonly",
    "deleteWorkout": "readonly",
    "seedDemoData": "readonly",
    "getWorkouts": "readonly",
    "updateChart": "readonly",
    "renderWeeklySummary": "readonly"
  },
  "rules": {
    "no-unused-vars": "warn"
  },
  "overrides": [
    {
      "files": ["server/**/*.js", "tests/**/*.js", "src/storage.js"],
      "env": {
        "browser": false,
        "node": true,
        "commonjs": true
      },
      "globals": {
        "localStorage": "readonly"
      }
    },
    {
      "files": ["tests/**/*.js"],
      "rules": {
        "no-eval": "off"
      }
    }
  ]
}
